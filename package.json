{
  "name": "b3-folder-app",
  "version": "1.0.0",
  "description": "Angular file-tree demo with NgRx state and user-dependent access rules.",
  "private": true,
  "homepage": "https://krasny-lis.github.io/b3-folder-app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krasny-Lis/b3-folder-app.git"
  },
  "keywords": [
    "angular",
    "typescript",
    "ngrx",
    "angular-material",
    "file-tree",
    "github-pages"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /b3-folder-app/",
    "watch": "ng build --watch --configuration development",
    "cypress:open": "cypress open",
    "e2e": "cypress run",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/cdk": "^19.2.14",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.14",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "cypress": "^13.17.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
